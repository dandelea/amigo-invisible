        "summary": "URL de descarga del archivo de deseos de alguien de la sala",
        "tags": [
          "lista de deseos"
        ]
      }
    }
  },
  "info": {
    "title": "Amigo Invisible API",
    "description": "API del MVP de Amigo Invisible.\n\nAutenticación: no hay cuentas. Cada enlace secreto (gestión o personal) lleva un token aleatorio de 32 bytes en el fragmento de la URL (#), que el cliente envía en la cabecera `Authorization: Bearer <token>`. El servidor solo guarda su hash SHA-256.\n\nErrores: todas las respuestas de error usan el esquema `ErrorResponseDto`.\n\nLos eventos de WebSocket no están aquí: se documentan en el README.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "token": {
        "scheme": "bearer",
        "bearerFormat": "token opaco (base64url, 32 bytes)",
        "type": "http",
        "description": "Token del enlace de gestión (organizador) o del enlace personal (participante)."
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "error": {
            "type": "string",
            "example": "NOT_FOUND",
            "description": "Código estable para que el cliente elija el texto a mostrar."
          },
          "message": {
            "type": "string",
            "example": "No encontrado"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      },
      "AvailabilityDto": {
        "type": "object",
        "properties": {
          "canCreateRoom": {
            "type": "boolean",
            "description": "false cuando se ha alcanzado MAX_ROOMS."
          }
        },
        "required": [
          "canCreateRoom"
        ]
      },
      "CreateRoomDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60,
            "example": "Cena de Navidad de la oficina"
          },
          "giftDate": {
            "type": "string",
            "format": "date",
            "example": "2026-12-20",
            "description": "Día de entrega de los regalos. De hoy a 2 años vista."
          },
          "budget": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000,
            "example": 15,
            "description": "Presupuesto sugerido en euros, con hasta 2 decimales."
          }
        },
        "required": [
          "name"
        ]
      },
      "RoomDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Cena de Navidad de la oficina"
          },
          "giftDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "2026-12-20"
          },
          "budget": {
            "type": "number",
            "nullable": true,
            "example": 15,
            "description": "Euros"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "drawn"
            ],
            "example": "open"
          },
          "pairRuleEnabled": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "name",
          "giftDate",
          "budget",
          "status",
          "pairRuleEnabled"
        ]
      },
      "CreateRoomResponseDto": {
        "type": "object",
        "properties": {
          "room": {
            "$ref": "#/components/schemas/RoomDto"
          },
          "inviteCode": {
            "type": "string",
            "example": "AbCdEfGhIjKlMnOp",
            "description": "Código del enlace de invitación: /s/<inviteCode>."
          },
          "manageToken": {
            "type": "string",
            "description": "Token del enlace de gestión: /o#<manageToken>. Se devuelve solo esta vez."
          }
        },
        "required": [
          "room",
          "inviteCode",
          "manageToken"
        ]
      },
      "InvitationDto": {
        "type": "object",
        "properties": {
          "room": {
            "$ref": "#/components/schemas/RoomDto"
          },
          "participantCount": {
            "type": "number",
            "example": 5
          },
          "maxParticipants": {
            "type": "number",
            "example": 30
          },
          "participantNames": {
            "example": [
              "Ana",
              "Luis",
              "Marta"
            ],
            "description": "Nombres de quienes ya están dentro. Vacío si no se puede entrar.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cannotJoinReason": {
            "type": "string",
            "enum": [
              "ROOM_FULL",
              "ROOM_CLOSED"
            ],
            "nullable": true,
            "description": "Motivo por el que no se puede entrar, o null si se puede."
          }
        },
        "required": [
          "room",
          "participantCount",
          "maxParticipants",
          "participantNames",
          "cannotJoinReason"
        ]
      },
      "JoinRoomDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "example": "Sofía",
            "description": "Letras, números, espacios y ' - . No puede repetirse en la sala (sin distinguir mayúsculas ni tildes)."
          }
        },
        "required": [
          "name"
        ]
      },
      "ParticipantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Ana"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "JoinRoomResponseDto": {
        "type": "object",
        "properties": {
          "participant": {
            "$ref": "#/components/schemas/ParticipantDto"
          },
          "participantToken": {
            "type": "string",
            "description": "Token del enlace personal: /p#<participantToken>. Se devuelve solo esta vez."
          }
        },
        "required": [
          "participant",
          "participantToken"
        ]
      },
      "WishlistDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "link",
              "file"
            ]
          },
          "url": {
            "type": "string",
            "nullable": true,
            "example": "https://ejemplo.com/mi-lista",
            "description": "Solo si kind = link."
          },
          "fileName": {
            "type": "string",
            "nullable": true,
            "example": "lista-deseos.pdf",
            "description": "Solo si kind = file. La descarga se pide aparte."
          },
          "fileType": {
            "type": "string",
            "nullable": true,
            "enum": [
              "PDF",
              "JPEG",
              "PNG",
              "WebP"
            ]
          },
          "fileSize": {
            "type": "number",
            "nullable": true,
            "example": 1258291
          }
        },
        "required": [
          "kind",
          "url",
          "fileName",
          "fileType",
          "fileSize"
        ]
      },
      "ParticipantWithWishlistDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Ana"
          },
          "wishlist": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/WishlistDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "wishlist"
        ]
      },
      "PairDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "participantIds": {
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "id",
          "participantIds"
        ]
      },
      "ParticipantViewDto": {
        "type": "object",
        "properties": {
          "room": {
            "$ref": "#/components/schemas/RoomDto"
          },
          "me": {
            "$ref": "#/components/schemas/ParticipantDto"
          },
          "participants": {
            "description": "Todos los participantes con su lista de deseos (visible para todos).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParticipantWithWishlistDto"
            }
          },
          "pairs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PairDto"
            }
          },
          "maxParticipants": {
            "type": "number",
            "example": 30
          }
        },
        "required": [
          "room",
          "me",
          "participants",
          "pairs",
          "maxParticipants"
        ]
      },
      "OrganizerViewDto": {
        "type": "object",
        "properties": {
          "room": {
            "$ref": "#/components/schemas/RoomDto"
          },
          "inviteCode": {
            "type": "string",
            "description": "Código del enlace de invitación."
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParticipantDto"
            }
          },
          "pairs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PairDto"
            }
          },
          "maxParticipants": {
            "type": "number",
            "example": 30
          }
        },
        "required": [
          "room",
          "inviteCode",
          "participants",
          "pairs",
          "maxParticipants"
        ]
      },
      "UpdateRoomDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "giftDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "budget": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000,
            "nullable": true
          }
        }
      },
      "SetPairRuleDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "CreatePairDto": {
        "type": "object",
        "properties": {
          "participantIds": {
            "minItems": 2,
            "maxItems": 2,
            "description": "Los dos participantes, sin pareja, de la misma sala.",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "participantIds"
        ]
      },
      "WishlistLinkDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000,
            "example": "https://ejemplo.com/mi-lista",
            "description": "Solo https."
          }
        },
        "required": [
          "url"
        ]
      },
      "DownloadUrlDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "URL firmada y temporal del almacenamiento. Descarga el archivo como adjunto."
          },
          "expiresInSeconds": {
            "type": "number",
            "example": 300
          }
        },
        "required": [
          "url",
          "expiresInSeconds"
        ]
      }
    }
  }
}
