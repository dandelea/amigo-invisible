{
  "version": "2.0.0",
  "tasks": [
    {
      // Servidor de Vite en segundo plano; la depuración en Chrome espera a
      // que esté listo.
      "label": "frontend: dev",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activesBegin": "VITE",
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "servicios: docker compose up",
      "type": "shell",
      "command": "docker compose up -d",
      "problemMatcher": []
    }
  ]
}
