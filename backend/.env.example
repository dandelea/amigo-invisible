# Copia este archivo a .env y rellena los valores. Nunca subas .env al repo.

NODE_ENV=development
PORT=3000
# Tope global de salas existentes.
MAX_ROOMS=10
# Origen del frontend permitido por CORS.
CORS_ORIGIN=http://localhost:5173
# Saltos de proxy de confianza (Render: 1).
TRUST_PROXY=1

# Fase 2: cadena de conexión de Neon (con ?sslmode=require).
DATABASE_URL=

# Fase 3: Cloudflare R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
