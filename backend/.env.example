# Copia este archivo a .env y rellena los valores. Nunca subas .env al repo.

NODE_ENV=development
PORT=3000

# PostgreSQL. En local, el de docker-compose.yml; en producción, la cadena
# de conexión de Neon (con ?sslmode=require).
DATABASE_URL=postgres://amigo:amigo@localhost:54329/amigo

# Tope global de salas existentes.
MAX_ROOMS=10
# Origen del frontend permitido por CORS.
CORS_ORIGIN=http://localhost:5173
# Saltos de proxy de confianza (Render: 1).
TRUST_PROXY=1

# Límites de peticiones por IP.
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_CREATE_ROOM_PER_HOUR=10
RATE_LIMIT_JOIN_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_HOUR=30

# Almacenamiento S3. En local, el VersityGW de docker-compose.yml. En
# producción, Cloudflare R2: S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# y S3_REGION=auto, con un token de API limitado al bucket.
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=amigo
S3_SECRET_ACCESS_KEY=amigo-secreto
S3_BUCKET=amigo
